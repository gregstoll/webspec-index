{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webspec-index.dev/schemas/effects/result.schema.json",
  "title": "WebSpec effects API results",
  "oneOf": [
    {"$ref": "#/$defs/summaryResult"},
    {"$ref": "#/$defs/explainResult"},
    {"$ref": "#/$defs/recomputeResult"}
  ],
  "$defs": {
    "effectId": {"type": "string", "pattern": "^ef_[0-9a-f]{16,64}$"},
    "analysisId": {"type": "string", "pattern": "^an_[0-9a-f]{16,64}$"},
    "effectValue": {"type": ["string", "boolean", "integer", "null"]},
    "params": {"type": "object", "additionalProperties": {"$ref": "#/$defs/effectValue"}},
    "execution": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["inline", "separate", "unknown"]}},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spec", "anchor", "snapshot_sha"],
      "properties": {
        "spec": {"type": "string", "minLength": 1},
        "anchor": {"type": "string", "minLength": 1},
        "snapshot_sha": {"type": "string", "minLength": 1},
        "step_id": {"type": "string"},
        "step_path": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "body_id": {"type": "string"}
      }
    },
    "requestSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spec", "anchor"],
      "properties": {
        "spec": {"type": "string", "minLength": 1},
        "anchor": {"type": "string", "minLength": 1},
        "step_path": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
        "step_id": {"type": "string"},
        "body_id": {"type": "string"}
      }
    },
    "effectLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spec", "anchor", "url"],
      "properties": {
        "spec": {"type": "string", "minLength": 1},
        "anchor": {"type": "string", "minLength": 1},
        "url": {"type": "string"},
        "step_path": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}}
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "params", "execution"],
      "properties": {
        "id": {"$ref": "#/$defs/effectId"},
        "kind": {"type": "string", "minLength": 1},
        "params": {"$ref": "#/$defs/params"},
        "execution": {"$ref": "#/$defs/execution"},
        "location": {"$ref": "#/$defs/effectLocation"},
        "other_locations": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/effectLocation"}},
        "additional_locations": {"type": "integer", "minimum": 0}
      }
    },
    "issueCode": {
      "enum": ["missing_spec", "missing_anchor", "unsupported_structure", "unresolved_invocation", "unresolved_body_binding", "unresolved_argument", "ambiguous_match", "declaration_mismatch", "analysis_budget", "snapshot_changed", "unsupported_preview", "witness_budget", "context_truncated"]
    },
    "readyStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "semantics", "coverage", "issues", "omitted", "analysis_id"],
      "properties": {
        "state": {"const": "ready"},
        "semantics": {"const": "may"},
        "coverage": {"enum": ["complete", "partial"]},
        "issues": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/issueCode"}},
        "omitted": {"type": "integer", "minimum": 0},
        "analysis_id": {"$ref": "#/$defs/analysisId"}
      }
    },
    "emptyStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "semantics", "issues", "omitted"],
      "properties": {
        "state": {"enum": ["pending", "unavailable", "error", "disabled"]},
        "semantics": {"const": "may"},
        "issues": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/issueCode"}},
        "omitted": {"const": 0}
      }
    },
    "status": {"oneOf": [{"$ref": "#/$defs/readyStatus"}, {"$ref": "#/$defs/emptyStatus"}]},
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {"start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 0}}
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subject", "url"],
      "properties": {
        "id": {"type": "string"},
        "subject": {"$ref": "#/$defs/subject"},
        "url": {"type": "string"},
        "segment_id": {"type": "string"},
        "span": {"$ref": "#/$defs/span"},
        "step_text": {"type": "string"}
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {"code": {"$ref": "#/$defs/issueCode"}, "message": {"type": "string"}, "site": {"$ref": "#/$defs/site"}}
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "basis", "rule_id", "site"],
      "properties": {
        "id": {"type": "string"},
        "basis": {"enum": ["matched", "declared"]},
        "rule_id": {"type": "string"},
        "site": {"$ref": "#/$defs/site"},
        "captures": {"type": "object", "additionalProperties": {"type": ["string", "null"]}},
        "argument_expressions": {"type": "object", "additionalProperties": {"type": "string"}},
        "reason": {"type": "string"}
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text", "site"],
      "properties": {
        "kind": {"enum": ["enclosing", "branch", "binding", "preceding_exit", "unsupported"]},
        "text": {"type": "string"},
        "site": {"$ref": "#/$defs/site"}
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution", "operation_site_id"],
      "properties": {
        "execution": {"enum": ["inline", "separate", "unknown"]},
        "operation_site_id": {"type": "string"},
        "effect": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "params"],
          "properties": {"kind": {"type": "string"}, "params": {"$ref": "#/$defs/params"}}
        }
      }
    },
    "hop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "relation", "site", "context"],
      "properties": {
        "from": {"$ref": "#/$defs/subject"},
        "to": {"$ref": "#/$defs/subject"},
        "relation": {"enum": ["invoke", "candidate_invoke", "define_body", "schedule_body", "resume", "implements", "mention"]},
        "site": {"$ref": "#/$defs/site"},
        "context": {"type": "array", "items": {"$ref": "#/$defs/context"}},
        "boundary": {"$ref": "#/$defs/boundary"}
      }
    },
    "witness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hops", "terminal_evidence", "path_feasibility", "issues"],
      "properties": {
        "hops": {"type": "array", "items": {"$ref": "#/$defs/hop"}},
        "terminal_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "path_feasibility": {"const": "unchecked"},
        "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}}
      }
    },
    "explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effect_id", "witnesses", "witnesses_truncated", "issues"],
      "properties": {
        "effect_id": {"$ref": "#/$defs/effectId"},
        "witnesses": {"type": "array", "items": {"$ref": "#/$defs/witness"}},
        "witnesses_truncated": {"type": "boolean"},
        "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}}
      }
    },
    "budgets": {
      "type": "object", "additionalProperties": false,
      "required": ["max_bodies", "max_relationships", "max_states"],
      "properties": {"max_bodies": {"type": "integer", "minimum": 1}, "max_relationships": {"type": "integer", "minimum": 1}, "max_states": {"type": "integer", "minimum": 1}}
    },
    "scope": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"const": "all"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "subject"], "properties": {"kind": {"const": "subject"}, "subject": {"$ref": "#/$defs/requestSubject"}}}
      ]
    },
    "manifest": {
      "type": "object", "additionalProperties": false,
      "required": ["specs", "structural_representation_version", "registry_resolution_version", "environment", "catalog_digest", "analysis_engine_version", "scope", "budget_profile", "missing_inputs"],
      "properties": {
        "specs": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["spec", "snapshot_sha"], "properties": {"spec": {"type": "string"}, "snapshot_sha": {"type": "string"}}}},
        "structural_representation_version": {"type": "integer", "minimum": 1},
        "registry_resolution_version": {"type": "integer", "minimum": 1},
        "environment": {"type": "string"},
        "catalog_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "analysis_engine_version": {"type": "integer", "minimum": 1},
        "scope": {"$ref": "#/$defs/scope"},
        "budget_profile": {"$ref": "#/$defs/budgets"},
        "missing_inputs": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["spec"], "properties": {"spec": {"type": "string"}, "anchor": {"type": "string"}}}}
      }
    },
    "definedBody": {
      "type": "object", "additionalProperties": false,
      "required": ["subject", "effects", "effects_status"],
      "properties": {"subject": {"$ref": "#/$defs/subject"}, "effects": {"type": "array", "items": {"$ref": "#/$defs/effect"}}, "effects_status": {"$ref": "#/$defs/status"}}
    },
    "summaryResult": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "subject", "effects", "effects_status", "defined_bodies", "issues"],
      "allOf": [
        {
          "if": {"properties": {"effects_status": {"properties": {"state": {"const": "ready"}}}}},
          "then": {"required": ["input_manifest"]},
          "else": {"not": {"required": ["input_manifest"]}, "properties": {"effects": {"maxItems": 0}, "defined_bodies": {"maxItems": 0}}}
        }
      ],
      "properties": {
        "schema_version": {"const": 1}, "subject": {"$ref": "#/$defs/subject"},
        "effects": {"type": "array", "items": {"$ref": "#/$defs/effect"}}, "effects_status": {"$ref": "#/$defs/status"},
        "defined_bodies": {"type": "array", "items": {"$ref": "#/$defs/definedBody"}},
        "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}}, "input_manifest": {"$ref": "#/$defs/manifest"}
      }
    },
    "explainResult": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "subject", "effects", "effects_status", "defined_bodies", "explanations", "issues"],
      "allOf": [
        {
          "if": {"properties": {"effects_status": {"properties": {"state": {"const": "ready"}}}}},
          "then": {"required": ["input_manifest"]},
          "else": {"not": {"required": ["input_manifest"]}, "properties": {"effects": {"maxItems": 0}, "defined_bodies": {"maxItems": 0}, "explanations": {"maxItems": 0}}}
        }
      ],
      "properties": {
        "schema_version": {"const": 1}, "subject": {"$ref": "#/$defs/subject"},
        "effects": {"type": "array", "items": {"$ref": "#/$defs/effect"}}, "effects_status": {"$ref": "#/$defs/status"},
        "defined_bodies": {"type": "array", "items": {"$ref": "#/$defs/definedBody"}},
        "explanations": {"type": "array", "items": {"$ref": "#/$defs/explanation"}},
        "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}}, "input_manifest": {"$ref": "#/$defs/manifest"}
      }
    },
    "recomputeResult": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "analysis_id", "input_manifest", "processed_subjects", "unprocessed_subjects", "body_count", "relationship_count", "state_count", "issues"],
      "properties": {
        "schema_version": {"const": 1}, "analysis_id": {"$ref": "#/$defs/analysisId"}, "input_manifest": {"$ref": "#/$defs/manifest"},
        "processed_subjects": {"type": "array", "items": {"$ref": "#/$defs/subject"}}, "unprocessed_subjects": {"type": "array", "items": {"$ref": "#/$defs/subject"}},
        "body_count": {"type": "integer", "minimum": 0}, "relationship_count": {"type": "integer", "minimum": 0}, "state_count": {"type": "integer", "minimum": 0},
        "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}}
      }
    }
  }
}
